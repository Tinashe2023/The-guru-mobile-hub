# Server
PORT=3001
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=your-jwt-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Session Secret (for passport)
SESSION_SECRET=your-session-secret-change-me

# WebAuthn
WEBAUTHN_RP_NAME=The Guru Mobile Hub
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Client URL
CLIENT_URL=http://localhost:5173

# ─── Backblaze B2 (S3-compatible) ───
B2_KEY_ID=your-backblaze-key-id
B2_APP_KEY=your-backblaze-application-key
B2_BUCKET_NAME=guru-mobile-hub
B2_ENDPOINT=s3.us-east-005.backblazeb2.com

# File Upload Limits
MAX_FILE_SIZE=10485760
MAX_AVATAR_SIZE=2097152

# Document Retention (days)
PERSONAL_DOC_RETENTION_DAYS=30
PRINT_JOB_RETENTION_DAYS=7

# Per-user storage quota (bytes, 50MB default)
USER_STORAGE_QUOTA=52428800
